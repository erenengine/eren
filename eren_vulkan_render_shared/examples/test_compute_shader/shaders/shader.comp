#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// 필요한 데이터는 push constant로 전달
layout(push_constant) uniform PushConstants {
    float time;
    float aspect_ratio;
    uint pre_transform; // 0=NONE, 1=90, 2=180, 3=270
} pc;

// 결과를 저장할 StorageBufferObject
layout(binding = 0) buffer StorageBufferObject {
    mat4 model;
    mat4 view;
    mat4 proj;
} sbo;

// 헬퍼 함수 (GLSL 버전의 lookAt)
mat4 lookAtRH(vec3 eye, vec3 center, vec3 up) {
    vec3 f = normalize(center - eye);
    vec3 s = normalize(cross(f, up));
    vec3 u = cross(s, f);

    return mat4(
        vec4(s, 0.0),
        vec4(u, 0.0),
        vec4(-f, 0.0),
        vec4(-dot(s, eye), -dot(u, eye), dot(f, eye), 1.0)
    );
}

// 헬퍼 함수 (GLSL 버전의 perspective)
mat4 perspectiveRH(float fovy, float aspect, float near, float far) {
    float f = 1.0 / tan(fovy / 2.0);
    return mat4(
        vec4(f / aspect, 0.0, 0.0, 0.0),
        vec4(0.0, f, 0.0, 0.0),
        vec4(0.0, 0.0, (far + near) / (near - far), -1.0),
        vec4(0.0, 0.0, (2.0 * far * near) / (near - far), 0.0)
    );
}

void main() {
    // model: Z축 기준 회전
    float angle = -radians(pc.time * 90.0);
    sbo.model = mat4(
        vec4(cos(angle), sin(angle), 0.0, 0.0),
        vec4(-sin(angle), cos(angle), 0.0, 0.0),
        vec4(0.0, 0.0, 1.0, 0.0),
        vec4(0.0, 0.0, 0.0, 1.0)
    );

    // view: 카메라 설정
    vec3 eye = vec3(2.0, 2.0, 2.0);
    vec3 center = vec3(0.0);
    vec3 up = vec3(0.0, 0.0, 1.0);
    sbo.view = lookAtRH(eye, center, up);

    // proj: 원근 투영
    mat4 proj = perspectiveRH(radians(45.0), pc.aspect_ratio, 0.1, 10.0);
    proj[1][1] *= -1.0; // Vulkan의 Y축 보정

    // pre_transform 보정
    mat4 correction = mat4(1.0);
    if (pc.pre_transform == 1u) {
        correction = mat4(
            vec4(0, 1, 0, 0),
            vec4(-1, 0, 0, 0),
            vec4(0, 0, 1, 0),
            vec4(0, 0, 0, 1)
        );
    } else if (pc.pre_transform == 2u) {
        correction = mat4(
            vec4(-1, 0, 0, 0),
            vec4(0, -1, 0, 0),
            vec4(0, 0, 1, 0),
            vec4(0, 0, 0, 1)
        );
    } else if (pc.pre_transform == 3u) {
        correction = mat4(
            vec4(0, -1, 0, 0),
            vec4(1, 0, 0, 0),
            vec4(0, 0, 1, 0),
            vec4(0, 0, 0, 1)
        );
    }

    sbo.proj = correction * proj;
}
